model User {
    id          String   @id @default(uuid())
    name        String
    email       String   @unique
    phone       String   @unique
    password    String
    role        UserRole @default(RIDER)
    driver      Driver?
    driverRides RideBooking[]   @relation("DriverRides")
    riderRides  RideBooking[]   @relation("RiderRides")
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("users")
}
